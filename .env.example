# Anthropic
ANTHROPIC_API_KEY=your_key_here

# Turso DB — progetti e storico richieste AI
TURSO_DB_URL=libsql://vmscout-therealmfkk.aws-eu-west-1.turso.io
TURSO_DB_TOKEN=your_token_here

# Auth — segreto per firmare lo state OAuth (HMAC). Opzionale: se assente si usa
# un hash di TURSO_DB_TOKEN. Impostalo per poter ruotare il token DB senza
# invalidare i flussi OAuth in corso.
AUTH_SECRET=

# Canva Connect API — server-side only (NO VITE_ prefix)
# Ottieni da: canva.com/developers → crea app → copia Client ID e Secret
# Redirect URI deve corrispondere ESATTAMENTE a quello configurato sul portal Canva
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=https://vmscout.vercel.app/api/canva-auth

# Photo APIs (optional — for image previews)
VITE_UNSPLASH_KEY=
VITE_PEXELS_KEY=
VITE_PIXABAY_KEY=
